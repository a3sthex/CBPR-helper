+  }
+
+  if (step === 2) {
+    const lp = wiz.lifepath;
+    $$('[data-lp-roll]', body).forEach(btn => btn.onclick = () => {
+      const cat = btn.dataset.lpRoll;
+      wizRollLifepath(cat);
+      renderWizard();
+    });
+    $$('[data-lp-role-roll]', body).forEach(btn => btn.onclick = () => {
+      const r = wiz.role;
+      const table = LP_ROLE[r];
