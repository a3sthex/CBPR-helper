+      wiz.stats[s] = v;
+      inp.value = v;
+      updateWizStatBar();
+    });
+    $('#wiz-st-roll').onclick = () => {
+      const arr = [8,7,7,6,6,6,6,6,5,5];
+      for (let i = arr.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [arr[i], arr[j]] = [arr[j], arr[i]]; }
+      state.meta.stats.forEach((s, i) => wiz.stats[s] = arr[i]);
+      renderWizard();
